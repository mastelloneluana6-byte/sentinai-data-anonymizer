OPENAI_API_KEY=plak_hier_jouw_key

# Comma-separated browser origins allowed to call the API (required for Vercel + browser uploads).
# Example:
# SENTINAI_CORS_ORIGINS=https://your-frontend.vercel.app,https://your-frontend-git-main.vercel.app
SENTINAI_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

